{
  "name": "glass-music",
  "version": "3.0.1",
  "description": "A futuristic, liquid-glass aesthetic music player for Linux, Windows, MacOS",
  "main": "main.js",
  "homepage": "https://github.com/glass-music/app",
  "author": {
    "name": "Glass Music",
    "email": "info@glassmusic.app"
  },
  "scripts": {
    "prestart": "node setup-electron.js",
    "start": "npm run electron:dev",
    "dev": "vite",
    "lint": "tsc --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preelectron:dev": "node setup-electron.js",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://127.0.0.1:3000 && electron --ozone-platform-hint=auto .\"",
    "postinstall": "node setup-electron.js || true",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build:win",
    "dist:snap": "npm run build:snap",
    "dist:linux": "npm run build:linux",
    "dist:mac": "npm run build:mac",
    "dist:flatpak": "npm run build:flatpak",
    "dist:flatpak:docker": "docker run --rm -it --privileged -v \"$PWD\":/project -w /project electronuserland/builder:18 bash -c \"apt-get update && apt-get install -y --no-install-recommends flatpak ostree && npm install && npm run build:flatpak && chown -R \\$(id -u):\\$(id -g) release/ node_modules/ 2>/dev/null || true\"",
    "dist:rpm": "npm run build:rpm",
    "dist:pacman": "npm run build:pacman",
    "dist:appimage": "npm run build:appimage",
    "dist:deb": "npm run build:deb",
    "dist:tar": "npm run build:tar",
    "dist:targz": "npm run build:targz",
    "build:linux": "npm run build && electron-builder --linux",
    "build:pacman": "npm run build && electron-builder --linux pacman",
    "build:appimage": "npm run build && electron-builder --linux AppImage",
    "build:deb": "npm run build && electron-builder --linux deb",
    "build:tar": "npm run build && electron-builder --linux tar.gz",
    "build:targz": "npm run build && electron-builder --linux tar.gz",
    "build:flatpak": "bash ./scripts/build-flatpak.sh",
    "build:rpm": "npm run build && electron-builder --linux rpm",
    "build:snap": "npm run build && electron-builder --linux snap -c.linux.executableName=\"glass-music-player\" -c.extraMetadata.name=\"glass-music-player\" -c.productName=\"Glass Music Player\"",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac --x64"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^1.43.0",
    "axios": "^1.18.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.38.0",
    "jsdom": "^29.1.1",
    "jsmediatags": "^3.9.5",
    "lamejs": "^1.2.1",
    "lucide-react": "^0.460.0",
    "metaflac-js": "^1.0.5",
    "motion": "^12.38.0",
    "music-metadata": "^11.15.0",
    "node-id3": "^0.2.6",
    "play-dl": "^1.9.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-virtuoso": "^4.18.3",
    "react-window": "^2.2.7",
    "soundcloud-downloader": "^1.0.0",
    "youtube-dl-exec": "^3.1.9",
    "yt-search": "^2.13.1"
  },
  "devDependencies": {
    "@types/jsmediatags": "^3.9.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.7",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.glass.music",
    "productName": "Glass Music",
    "asarUnpack": [
      "node_modules/youtube-dl-exec/bin/**/*",
      "node_modules/fluent-ffmpeg/bin/**/*",
      "node_modules/@ffmpeg-installer/linux-x64/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "downloader.js",
      "assets/**/*",
      "trei/**/*"
    ],
    "linux": {
      "executableName": "glass-music",
      "target": [
        "AppImage",
        "deb",
        "pacman",
        "tar.gz"
      ],
      "icon": "build/icons/linux/",
      "category": "Audio",
      "maintainer": "Glass Music Team <info@glassmusic.app>"
    },
    "snap": {
      "publish": [
        "github"
      ],
      "confinement": "strict",
      "grade": "stable",
      "plugs": [
        "default",
        "home",
        "removable-media",
        "audio-playback"
      ]
    },
    "flatpak": {
      "runtimeVersion": "25.08",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/windows/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/mac/icon.icns",
      "category": "public.app-category.music"
    }
  }
}
